# Copy to .env and fill in. Never commit .env.
DISCORD_TOKEN=
# One LLM key is enough. OpenAI is used if set, else Gemini; with neither, the bot runs offline.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional overrides
# LLM_PROVIDER=openai        # openai | gemini | anthropic | offline
# LLM_MODEL=gpt-4.1-mini
# DASHBOARD_PORT=8765
# SIM_DELAY=2.5              # seconds simulated students wait before replying
